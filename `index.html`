<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GhostInk — vertical comics</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&amp;family=JetBrains+Mono:wght@400;600&amp;family=Work+Sans:wght@400;500;600;700&amp;family=Noto+Sans+JP:wght@700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.cdnfonts.com/css/overdrive-sunset" rel="stylesheet">
<style>
  :root{
    --ink:#15130f;
    --ink-2:#1e1b15;
    --paper:#f3ecdd;
    --paper-dim:#d9cfb8;
    --brush:#e8402b;
    --brush-dim:#a92e1f;
    --jade:#2f8f7a;
    --jade-dim:#1f6455;
    --muted:#8b8579;
    --display: 'Anton', sans-serif;
    --body: 'Work Sans', sans-serif;
    --mono: 'JetBrains Mono', monospace;
    --radius: 3px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--ink);
    color:var(--paper);
    font-family:var(--body);
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
  }
  a{color:inherit;text-decoration:none;}
  button{font-family:var(--body);cursor:pointer;}
  ::selection{background:var(--brush);color:var(--paper);}
  ::-webkit-scrollbar{width:10px;}
  ::-webkit-scrollbar-track{background:var(--ink);}
  ::-webkit-scrollbar-thumb{background:var(--paper-dim);border-radius:10px;}

  /* ---------- header ---------- */
  header.site{
    position:sticky;top:0;z-index:50;
    display:flex;align-items:center;gap:24px;
    padding:14px 28px;
    background:rgba(21,19,15,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(243,236,221,0.1);
  }
  .logo-img{
    height:34px;
    width:auto;
    display:block;
    cursor:pointer;
  }
  nav.site-nav{display:flex;gap:4px;margin-left:8px;}
  nav.site-nav a{
    font-size:13px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;
    padding:8px 14px;border-radius:var(--radius);
    color:var(--muted);
  }
  nav.site-nav a:hover{color:var(--paper);}
  nav.site-nav a.active{color:var(--ink);background:var(--paper);}
  .search-wrap{flex:1;max-width:340px;margin-left:auto;position:relative;}
  .search-wrap input{
    width:100%;padding:9px 14px 9px 34px;
    background:var(--ink-2);border:1px solid rgba(243,236,221,0.15);
    border-radius:20px;color:var(--paper);font-size:13px;
  }
  .search-wrap input::placeholder{color:var(--muted);}
  .search-wrap svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:14px;height:14px;stroke:var(--muted);}
  .btn-primary{
    background:var(--brush);color:var(--paper);border:none;
    padding:10px 18px;border-radius:var(--radius);font-weight:700;font-size:13px;
    letter-spacing:0.5px;text-transform:uppercase;
  }
  .btn-primary:hover{background:var(--brush-dim);}
  .btn-ghost{
    background:transparent;color:var(--paper);border:1px solid rgba(243,236,221,0.3);
    padding:9px 16px;border-radius:var(--radius);font-weight:600;font-size:13px;
  }
  .btn-ghost:hover{border-color:var(--paper);}

  #app{max-width:1200px;margin:0 auto;padding:0 28px 80px;}

  /* ---------- hero ---------- */
  .hero{
    margin-top:28px;border-radius:6px;overflow:hidden;position:relative;
    min-height:360px;display:flex;align-items:flex-end;
    background:linear-gradient(120deg,var(--brush-dim),var(--ink) 70%);
  }
  .hero::before{
    content:"";position:absolute;inset:0;
    background:radial-gradient(circle at 80% 20%, rgba(232,64,43,0.35), transparent 55%),
               radial-gradient(circle at 10% 90%, rgba(47,143,122,0.25), transparent 45%);
  }
  .hero-inner{position:relative;padding:36px;max-width:640px;}
  .eyebrow{
    font-family:var(--mono);font-size:12px;letter-spacing:2px;text-transform:uppercase;
    color:var(--paper);opacity:0.75;margin-bottom:10px;
  }
  .hero h1{
    font-family:var(--display);font-size:56px;line-height:0.95;margin:0 0 14px;
    text-transform:uppercase;letter-spacing:0.5px;
  }
  .hero p{font-size:15px;line-height:1.6;color:var(--paper-dim);margin:0 0 22px;max-width:520px;}
  .hero-actions{display:flex;gap:12px;}

  /* ---------- shelves ---------- */
  .shelf{margin-top:52px;}
  .shelf-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:16px;}
  .shelf-head h2{
    font-family:var(--display);font-size:24px;text-transform:uppercase;letter-spacing:0.5px;margin:0;
    display:flex;align-items:center;gap:10px;
  }
  .shelf-head h2 .tick{width:22px;height:3px;background:var(--brush);display:inline-block;}
  .shelf-head .count{font-family:var(--mono);font-size:12px;color:var(--muted);}
  .shelf-row{display:flex;gap:18px;overflow-x:auto;padding-bottom:10px;scroll-snap-type:x proximity;}
  .shelf-row::-webkit-scrollbar{height:6px;}

  .card{
    flex:0 0 168px;scroll-snap-align:start;cursor:pointer;
  }
  .cover{
    width:168px;height:224px;border-radius:4px;position:relative;overflow:hidden;
    display:flex;align-items:flex-end;padding:12px;
    box-shadow:0 8px 20px rgba(0,0,0,0.4);
    transition:transform .15s ease;
  }
  .card:hover .cover{transform:translateY(-4px);}
  .cover .title{font-family:var(--display);font-size:17px;line-height:1;text-transform:uppercase;color:#fff;text-shadow:0 2px 6px rgba(0,0,0,0.6);}
  .card .meta{margin-top:8px;font-size:12px;color:var(--muted);}
  .card .meta .author{color:var(--paper-dim);display:block;font-weight:600;font-size:13px;margin-bottom:2px;}
  .genre-pill{
    display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:1px;text-transform:uppercase;
    background:rgba(0,0,0,0.4);color:var(--paper);padding:3px 8px;border-radius:10px;margin-bottom:6px;
    backdrop-filter:blur(2px);
  }

  /* ---------- series detail ---------- */
  .series-hero{display:flex;gap:32px;margin-top:32px;align-items:flex-start;flex-wrap:wrap;}
  .series-cover{width:230px;height:310px;border-radius:6px;flex:0 0 230px;box-shadow:0 12px 30px rgba(0,0,0,0.5);}
  .series-info{flex:1;min-width:280px;}
  .series-info .genre-pill{background:var(--jade-dim);}
  .series-info h1{font-family:var(--display);font-size:40px;text-transform:uppercase;margin:8px 0 4px;line-height:1;}
  .series-info .by{color:var(--muted);font-size:14px;margin-bottom:16px;}
  .series-info .by b{color:var(--paper-dim);}
  .series-info .synopsis{color:var(--paper-dim);line-height:1.7;font-size:14.5px;max-width:640px;margin-bottom:20px;}
  .stat-row{display:flex;gap:22px;margin-bottom:22px;font-family:var(--mono);font-size:12px;color:var(--muted);}
  .stat-row b{color:var(--paper);font-size:15px;display:block;font-family:var(--body);}
  .action-row{display:flex;gap:10px;}

  .chapter-list{margin-top:44px;}
  .chapter-row{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 18px;border-bottom:1px solid rgba(243,236,221,0.08);
    transition:background .1s;
  }
  .chapter-row:hover{background:rgba(243,236,221,0.04);}
  .chapter-left{display:flex;align-items:center;gap:16px;}
  .chapter-num{font-family:var(--mono);color:var(--brush);font-size:13px;width:44px;}
  .chapter-title{font-weight:600;font-size:14.5px;}
  .chapter-date{font-family:var(--mono);font-size:11.5px;color:var(--muted);}
  .read-badge{font-family:var(--mono);font-size:10px;color:var(--jade);letter-spacing:1px;}

  /* ---------- reader ---------- */
  .reader-shell{display:flex;gap:0;margin-top:8px;}
  .ink-rail{
    position:sticky;top:74px;height:calc(100vh - 100px);width:6px;
    background:rgba(243,236,221,0.08);border-radius:4px;margin-right:22px;flex:0 0 6px;
    overflow:hidden;
  }
  .ink-rail-fill{
    width:100%;background:linear-gradient(var(--brush),var(--jade));
    position:absolute;bottom:0;left:0;transition:height .05s linear;border-radius:4px;
  }
  .reader-main{flex:1;max-width:720px;margin:0 auto;}
  .reader-topbar{
    display:flex;align-items:center;justify-content:space-between;padding:20px 0 8px;
    border-bottom:1px solid rgba(243,236,221,0.1);margin-bottom:6px;
  }
  .reader-topbar .stitle{font-size:13px;color:var(--muted);}
  .reader-topbar .ctitle{font-family:var(--display);font-size:20px;text-transform:uppercase;}
  .panel{width:100%;display:block;margin:0;border-radius:0;}
  .panel-placeholder{
    width:100%;aspect-ratio:3/4;display:flex;align-items:center;justify-content:center;
    position:relative;overflow:hidden;
  }
  .panel-placeholder .cap{
    position:relative;font-family:var(--mono);color:rgba(255,255,255,0.75);font-size:11px;
    letter-spacing:1px;text-transform:uppercase;
  }
  .reader-end{padding:40px 0;text-align:center;}
  .reader-end .btn-primary{margin-top:12px;}
  .chapter-nav{display:flex;justify-content:space-between;padding:24px 0;border-top:1px solid rgba(243,236,221,0.1);margin-top:10px;}

  /* comments */
  .comments{margin-top:40px;padding-top:24px;border-top:1px solid rgba(243,236,221,0.1);}
  .comments h3{font-family:var(--display);font-size:18px;text-transform:uppercase;margin-bottom:16px;}
  .comment-form{display:flex;gap:10px;margin-bottom:20px;}
  .comment-form input{
    flex:1;padding:10px 14px;background:var(--ink-2);border:1px solid rgba(243,236,221,0.15);
    border-radius:var(--radius);color:var(--paper);font-size:13px;
  }
  .comment{padding:12px 0;border-bottom:1px solid rgba(243,236,221,0.06);}
  .comment .who{font-weight:700;font-size:13px;color:var(--jade);margin-right:8px;}
  .comment .when{font-family:var(--mono);font-size:10.5px;color:var(--muted);}
  .comment p{margin:4px 0 0;font-size:13.5px;color:var(--paper-dim);}

  /* ---------- upload ---------- */
  .form-card{
    background:var(--ink-2);border:1px solid rgba(243,236,221,0.1);border-radius:6px;
    padding:28px;max-width:640px;margin-top:24px;
  }
  .form-card h2{font-family:var(--display);font-size:24px;text-transform:uppercase;margin:0 0 6px;}
  .form-card .sub{color:var(--muted);font-size:13px;margin-bottom:24px;}
  .field{margin-bottom:18px;}
  .field label{display:block;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--muted);margin-bottom:6px;}
  .field input, .field textarea, .field select{
    width:100%;padding:11px 14px;background:var(--ink);border:1px solid rgba(243,236,221,0.15);
    border-radius:var(--radius);color:var(--paper);font-size:14px;font-family:var(--body);
  }
  .field textarea{resize:vertical;min-height:80px;}
  .swatch-row{display:flex;gap:8px;flex-wrap:wrap;}
  .swatch{width:32px;height:32px;border-radius:50%;cursor:pointer;border:2px solid transparent;}
  .swatch.sel{border-color:var(--paper);}
  .panel-editor{border:1px dashed rgba(243,236,221,0.25);border-radius:4px;padding:14px;margin-bottom:10px;}
  .panel-editor-row{display:flex;gap:10px;align-items:center;}
  .panel-editor-row input{flex:1;}
  .remove-x{background:none;border:none;color:var(--brush);font-size:18px;padding:4px 8px;}
  .add-panel-btn{
    width:100%;padding:10px;border:1px dashed rgba(243,236,221,0.3);background:transparent;color:var(--paper-dim);
    border-radius:4px;font-size:13px;margin-top:6px;
  }
  .add-panel-btn:hover{border-color:var(--paper);color:var(--paper);}

  .empty-state{text-align:center;padding:80px 20px;color:var(--muted);}
  .empty-state h3{font-family:var(--display);font-size:26px;color:var(--paper);text-transform:uppercase;margin-bottom:8px;}

  .grid-series{display:grid;grid-template-columns:repeat(auto-fill,minmax(168px,1fr));gap:18px 18px;margin-top:20px;}

  .toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
    background:var(--paper);color:var(--ink);padding:12px 20px;border-radius:20px;
    font-size:13px;font-weight:600;z-index:100;opacity:0;pointer-events:none;transition:opacity .2s, transform .2s;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(-6px);}

  footer.site{
    text-align:center;padding:40px 20px;color:var(--muted);font-family:var(--mono);font-size:11px;
    border-top:1px solid rgba(243,236,221,0.08);margin-top:60px;
  }

  @media(max-width:640px){
    header.site{padding:12px 16px;gap:12px;}
    nav.site-nav{display:none;}
    .search-wrap{max-width:none;}
    #app{padding:0 16px 60px;}
    .hero h1{font-size:36px;}
    .hero-inner{padding:22px;}
    .series-cover{width:150px;height:200px;flex-basis:150px;}
    .series-info h1{font-size:28px;}
    .ink-rail{display:none;}
  }
</style>
</head>
<body>

<header class="site">
  <img class="logo-img" src="data:image/png;base64," alt="GhostInk" onclick="location.hash='#/home'">
  <nav class="site-nav" id="siteNav">
    <a href="#/home" data-route="home" class="active">Home</a>
    <a href="#/browse" data-route="browse">Series</a>
    <a href="#/about" data-route="about">About</a>
    <a href="#/library" data-route="library">Library</a>
  </nav>
  <div class="search-wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
    <input id="searchInput" placeholder="Search this series…">
  </div>
  <button class="btn-ghost" onclick="location.hash='#/about'">Support</button>
</header>

<div id="app"></div>
<div class="toast" id="toast"></div>

<footer class="site">GhostInk — the webtoon studio of <span id="footerArtist">Mara Voss</span> · <a href="#/upload" style="text-decoration:underline;opacity:0.7;">publish new chapter</a></footer>

<script>
/* ================= DATA LAYER ================= */
const GENRES = ["Fantasy","Romance","Action","Slice of Life","Horror","Sci-Fi","Comedy","Drama"];

/* ---- single-artist identity (edit this to make it yours) ---- */
const ARTIST = {
  name: "Mara Voss",
  tagline: "Ink-and-scroll stories about the quiet, uncanny corners of ordinary places.",
  bio: "I've been drawing vertical-scroll comics since 2019 — usually something involving fog, folklore, or a diner that shouldn't exist. GhostInk is where every chapter lands first, straight from my sketchbook to your screen.",
  location: "Based in Montréal",
  socials: [
    { label: "Instagram", url: "https://instagram.com" },
    { label: "Twitter / X", url: "https://twitter.com" },
    { label: "Newsletter", url: "#" }
  ],
  support: [
    { label: "Ko-fi", url: "https://ko-fi.com" },
    { label: "Patreon", url: "https://patreon.com" },
    { label: "Print Shop", url: "#" }
  ]
};
const COVER_PALETTES = [
  ["#e8402b","#7a1f14"],["#2f8f7a","#123a32"],["#c98a2b","#5c3a10"],
  ["#5a4fc9","#241f5c"],["#c92b6a","#5c1030"],["#2b8bc9","#0f3a5c"],
  ["#8f2fce","#3a1263"],["#4fa63d","#1c4515"]
];

function uid(prefix){ return prefix + "_" + Math.random().toString(36).slice(2,9) + Date.now().toString(36).slice(-4); }
function hash(str){ let h=0; for(let i=0;i<str.length;i++){ h = (h*31 + str.charCodeAt(i))|0; } return Math.abs(h); }
function paletteFor(seed){ return COVER_PALETTES[hash(seed) % COVER_PALETTES.length]; }
function fmtDate(ts){ const d=new Date(ts); return d.toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'}); }
function timeAgo(ts){
  const s = Math.floor((Date.now()-ts)/1000);
  if(s<60) return "just now";
  if(s<3600) return Math.floor(s/60)+"m ago";
  if(s<86400) return Math.floor(s/3600)+"h ago";
  return Math.floor(s/86400)+"d ago";
}
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toast._tm);
  toast._tm = setTimeout(()=>t.classList.remove('show'), 2200);
}

const Store = {
  async getIndex(){
    try{ const r = await window.storage.get('series-index', true); return r ? JSON.parse(r.value) : []; }
    catch(e){ return []; }
  },
  async saveIndex(arr){ await window.storage.set('series-index', JSON.stringify(arr), true); },
  async getSeries(id){
    try{ const r = await window.storage.get('series:'+id, true); return r ? JSON.parse(r.value) : null; }
    catch(e){ return null; }
  },
  async saveSeries(s){ await window.storage.set('series:'+s.id, JSON.stringify(s), true); },
  async getAllSeries(){
    const idx = await this.getIndex();
    const all = await Promise.all(idx.map(id=>this.getSeries(id)));
    return all.filter(Boolean).sort((a,b)=>b.updatedAt-a.updatedAt);
  },
  async getComments(chapterId){
    try{ const r = await window.storage.get('comments:'+chapterId, true); return r? JSON.parse(r.value):[]; }
    catch(e){ return []; }
  },
  async addComment(chapterId, who, text){
    const list = await this.getComments(chapterId);
    list.push({id:uid('c'), who, text, ts:Date.now()});
    await window.storage.set('comments:'+chapterId, JSON.stringify(list), true);
    return list;
  },
  async getLibrary(){
    try{ const r = await window.storage.get('my-library', false); return r? JSON.parse(r.value):[]; }
    catch(e){ return []; }
  },
  async toggleLibrary(seriesId){
    let lib = await this.getLibrary();
    if(lib.includes(seriesId)) lib = lib.filter(x=>x!==seriesId);
    else lib.push(seriesId);
    await window.storage.set('my-library', JSON.stringify(lib), false);
    return lib;
  },
  async getProgress(seriesId){
    try{ const r = await window.storage.get('progress:'+seriesId, false); return r? JSON.parse(r.value):null; }
    catch(e){ return null; }
  },
  async setProgress(seriesId, chapterId){
    await window.storage.set('progress:'+seriesId, JSON.stringify({chapterId, ts:Date.now()}), false);
  }
};

/* seed some demo content on first run */
async function seedIfEmpty(){
  const idx = await Store.getIndex();
  if(idx.length > 0) return;
  const seeds = [
    {title:"Low Tide Diner", author:ARTIST.name, genre:"Slice of Life",
     synopsis:"A tiny diner at the edge of town, open only during low tide, and the strange regulars who always seem to arrive on time. My ongoing series — new chapters weekly."},
    {title:"The Hollow Choir", author:ARTIST.name, genre:"Horror",
     synopsis:"Every year the village sings the same song to keep something asleep beneath the chapel. This year, someone forgets a line."},
    {title:"Nine Tailwinds", author:ARTIST.name, genre:"Fantasy",
     synopsis:"A courier fox-spirit runs letters between the mortal world and the underworld — until one delivery goes catastrophically wrong."},
    {title:"Static Bloom", author:ARTIST.name, genre:"Sci-Fi",
     synopsis:"In a city where flowers grow from broken radios, a repair girl discovers her signals reach further than she thought. A completed short series."},
  ];
  const now = Date.now();
  const ids = [];
  for(let i=0;i<seeds.length;i++){
    const s = seeds[i];
    const id = uid('s');
    const chapters = [];
    const chCount = 3 + (i%3);
    for(let c=1;c<=chCount;c++){
      const panels = [];
      const pCount = 4 + (c%3);
      for(let p=0;p<pCount;p++){ panels.push({url:null, seed: id+'-'+c+'-'+p, caption: 'panel '+(p+1)}); }
      chapters.push({id:uid('ch'), num:c, title: c===1 ? "Prologue" : "Chapter "+c, panels, createdAt: now - (chCount-c)*86400000*3});
    }
    const series = {
      id, title:s.title, author:s.author, genre:s.genre, synopsis:s.synopsis,
      chapters, likes: 40+i*17, views: 900+i*430, createdAt: now-i*86400000, updatedAt: now-i*3600000
    };
    await Store.saveSeries(series);
    ids.push(id);
  }
  await Store.saveIndex(ids);
}

/* ================= RENDER HELPERS ================= */
function coverStyle(seed){
  const [c1,c2] = paletteFor(seed);
  return `background:linear-gradient(155deg, ${c1}, ${c2} 75%);`;
}
function panelPlaceholderStyle(seed){
  const [c1,c2] = paletteFor(seed);
  const angle = (hash(seed)%360);
  return `background:
    radial-gradient(circle at ${hash(seed+'x')%100}% ${hash(seed+'y')%100}%, ${c1}55, transparent 60%),
    linear-gradient(${angle}deg, ${c1}, ${c2});`;
}

function seriesCard(s){
  const chCount = s.chapters.length;
  return `
  <div class="card" onclick="location.hash='#/series/${s.id}'">
    <div class="cover" style="${coverStyle(s.id)}">
      <div>
        <span class="genre-pill">${s.genre}</span><br/>
        <span class="title">${escapeHtml(s.title)}</span>
      </div>
    </div>
    <div class="meta"><span class="author">${escapeHtml(s.author)}</span>${chCount} ch · ${s.likes}♥</div>
  </div>`;
}

function shelfHtml(title, list){
  if(list.length===0) return '';
  return `
  <div class="shelf">
    <div class="shelf-head">
      <h2><span class="tick"></span>${title}</h2>
      <span class="count">${list.length} series</span>
    </div>
    <div class="shelf-row">${list.map(seriesCard).join('')}</div>
  </div>`;
}

/* ================= ROUTES ================= */
const app = document.getElementById('app');

async function renderHome(){
  await seedIfEmpty();
  const all = await Store.getAllSeries();
  const ongoing = all.filter(s=>true); // all series belong to the one artist
  const latest = [...all].sort((a,b)=>b.updatedAt-a.updatedAt)[0];
  const latestChapter = latest ? [...latest.chapters].sort((a,b)=>b.num-a.num)[0] : null;

  app.innerHTML = `
    <div class="hero">
      <div class="hero-inner">
        <div class="eyebrow">${escapeHtml(ARTIST.location)}</div>
        <h1>${escapeHtml(ARTIST.name)}</h1>
        <p>${escapeHtml(ARTIST.tagline)}</p>
        <div class="hero-actions">
          ${latest ? `<button class="btn-primary" onclick="location.hash='#/read/${latest.id}/${latestChapter.id}'">Read Latest Chapter</button>` : ''}
          <button class="btn-ghost" onclick="location.hash='#/about'">About Me</button>
        </div>
      </div>
    </div>

    ${latest ? `
    <div class="shelf" style="margin-top:40px;">
      <div class="shelf-head"><h2><span class="tick"></span>Just Updated</h2></div>
      <div class="card" style="flex-basis:auto;width:220px;cursor:pointer;" onclick="location.hash='#/read/${latest.id}/${latestChapter.id}'">
        <div class="cover" style="${coverStyle(latest.id)};width:220px;height:120px;">
          <div><span class="genre-pill">${latest.genre}</span><br/><span class="title" style="font-size:15px;">${escapeHtml(latest.title)}</span></div>
        </div>
        <div class="meta">#${latestChapter.num} — ${escapeHtml(latestChapter.title)} · ${fmtDate(latestChapter.createdAt)}</div>
      </div>
    </div>` : ''}

    <div class="shelf">
      <div class="shelf-head"><h2><span class="tick"></span>All Series</h2><span class="count">${all.length} title${all.length===1?'':'s'}</span></div>
      ${all.length ? `<div class="grid-series">${all.map(seriesCard).join('')}</div>` :
        `<div class="empty-state"><h3>Nothing here yet</h3>Your first series will show up here once you publish it.</div>`}
    </div>
  `;
}

async function renderAbout(){
  const [c1,c2] = paletteFor(ARTIST.name);
  app.innerHTML = `
    <div class="series-hero">
      <div class="series-cover" style="width:200px;height:200px;border-radius:50%;flex-basis:200px;
        background:linear-gradient(155deg, ${c1}, ${c2} 75%);display:flex;align-items:center;justify-content:center;
        font-family:var(--display);font-size:64px;color:rgba(255,255,255,0.85);">
        ${escapeHtml(ARTIST.name.split(' ').map(w=>w[0]).join(''))}
      </div>
      <div class="series-info">
        <h1>${escapeHtml(ARTIST.name)}</h1>
        <div class="by">${escapeHtml(ARTIST.location)}</div>
        <p class="synopsis">${escapeHtml(ARTIST.bio)}</p>
        <div class="shelf-head" style="margin-bottom:10px;"><h2 style="font-size:16px;"><span class="tick"></span>Find me</h2></div>
        <div class="action-row" style="flex-wrap:wrap;margin-bottom:22px;">
          ${ARTIST.socials.map(s=>`<a class="btn-ghost" href="${escapeHtml(s.url)}" target="_blank" rel="noopener">${escapeHtml(s.label)}</a>`).join('')}
        </div>
        <div class="shelf-head" style="margin-bottom:10px;"><h2 style="font-size:16px;"><span class="tick"></span>Support the work</h2></div>
        <div class="action-row" style="flex-wrap:wrap;">
          ${ARTIST.support.map(s=>`<a class="btn-primary" style="display:inline-block;" href="${escapeHtml(s.url)}" target="_blank" rel="noopener">${escapeHtml(s.label)}</a>`).join('')}
        </div>
      </div>
    </div>
  `;
}

async function renderBrowse(genreFilter){
  const all = await Store.getAllSeries();
  const filtered = genreFilter ? all.filter(s=>s.genre===genreFilter) : all;
  app.innerHTML = `
    <div class="shelf" style="margin-top:32px;">
      <div class="shelf-head">
        <h2><span class="tick"></span>${genreFilter || 'All Series'}</h2>
        <span class="count">${filtered.length} series</span>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:22px;">
        <a href="#/browse" class="btn-ghost" style="padding:6px 12px;font-size:12px;">All</a>
        ${GENRES.map(g=>`<a href="#/browse/${encodeURIComponent(g)}" class="btn-ghost" style="padding:6px 12px;font-size:12px;">${g}</a>`).join('')}
      </div>
      <div class="grid-series">${filtered.map(seriesCard).join('')}</div>
      ${filtered.length===0 ? `<div class="empty-state"><h3>No series here</h3>Try another genre.</div>` : ''}
    </div>
  `;
}

async function renderSeries(id){
  const s = await Store.getSeries(id);
  if(!s){ app.innerHTML = `<div class="empty-state"><h3>Series not found</h3></div>`; return; }
  const lib = await Store.getLibrary();
  const inLib = lib.includes(id);
  const progress = await Store.getProgress(id);
  const chaptersDesc = [...s.chapters].sort((a,b)=>b.num-a.num);

  app.innerHTML = `
    <div class="series-hero">
      <div class="series-cover" style="${coverStyle(s.id)}"></div>
      <div class="series-info">
        <span class="genre-pill">${s.genre}</span>
        <h1>${escapeHtml(s.title)}</h1>
        <div class="by">by <b>${escapeHtml(s.author)}</b></div>
        <p class="synopsis">${escapeHtml(s.synopsis)}</p>
        <div class="stat-row">
          <div><b>${s.chapters.length}</b>chapters</div>
          <div><b>${s.likes}</b>likes</div>
          <div><b>${s.views}</b>views</div>
          <div><b>${fmtDate(s.createdAt)}</b>started</div>
        </div>
        <div class="action-row">
          <button class="btn-primary" onclick="location.hash='#/read/${s.id}/${(progress&&s.chapters.find(c=>c.id===progress.chapterId))?progress.chapterId:s.chapters[0].id}'">${progress? 'Continue Reading':'Start Reading'}</button>
          <button class="btn-ghost" id="libBtn">${inLib ? '✓ In Library':'+ Add to Library'}</button>
          <button class="btn-ghost" id="likeBtn">♥ ${s.likes}</button>
        </div>
      </div>
    </div>
    <div class="chapter-list">
      <div class="shelf-head"><h2><span class="tick"></span>Chapters</h2></div>
      ${chaptersDesc.map(c=>`
        <div class="chapter-row" onclick="location.hash='#/read/${s.id}/${c.id}'">
          <div class="chapter-left">
            <span class="chapter-num">#${c.num}</span>
            <div>
              <div class="chapter-title">${escapeHtml(c.title)}</div>
              <div class="chapter-date">${fmtDate(c.createdAt)} · ${c.panels.length} panels</div>
            </div>
          </div>
          ${progress && progress.chapterId===c.id ? '<span class="read-badge">● LAST READ</span>' : ''}
        </div>
      `).join('')}
    </div>
  `;
  document.getElementById('libBtn').onclick = async (e)=>{
    e.stopPropagation();
    const lib2 = await Store.toggleLibrary(id);
    toast(lib2.includes(id) ? 'Added to library' : 'Removed from library');
    renderSeries(id);
  };
  document.getElementById('likeBtn').onclick = async (e)=>{
    e.stopPropagation();
    s.likes += 1; await Store.saveSeries(s);
    toast('Liked!');
    renderSeries(id);
  };
}

async function renderReader(seriesId, chapterId){
  const s = await Store.getSeries(seriesId);
  if(!s){ app.innerHTML = `<div class="empty-state"><h3>Series not found</h3></div>`; return; }
  const chapters = [...s.chapters].sort((a,b)=>a.num-b.num);
  const idx = chapters.findIndex(c=>c.id===chapterId);
  const chapter = chapters[idx];
  if(!chapter){ app.innerHTML = `<div class="empty-state"><h3>Chapter not found</h3></div>`; return; }

  s.views = (s.views||0) + 1;
  await Store.saveSeries(s);
  await Store.setProgress(seriesId, chapterId);

  const prev = chapters[idx-1];
  const next = chapters[idx+1];
  const comments = await Store.getComments(chapterId);

  app.innerHTML = `
    <div class="reader-shell">
      <div class="ink-rail"><div class="ink-rail-fill" id="railFill" style="height:0%;"></div></div>
      <div class="reader-main">
        <div class="reader-topbar">
          <div>
            <div class="stitle"><a href="#/series/${s.id}">${escapeHtml(s.title)}</a></div>
            <div class="ctitle">#${chapter.num} — ${escapeHtml(chapter.title)}</div>
          </div>
          <div class="stitle">${chapter.panels.length} panels</div>
        </div>
        <div id="panelsWrap">
          ${chapter.panels.map((p,i)=> p.url
            ? `<img class="panel" src="${escapeHtml(p.url)}" alt="panel ${i+1}" loading="lazy" onerror="this.style.display='none'"/>`
            : `<div class="panel panel-placeholder" style="${panelPlaceholderStyle(p.seed || (chapter.id+i))}"><span class="cap">${escapeHtml(p.caption||('panel '+(i+1)))}</span></div>`
          ).join('')}
        </div>
        <div class="reader-end">
          <div class="eyebrow">End of chapter</div>
          <div style="font-family:var(--display);font-size:22px;text-transform:uppercase;">${next? 'Next up: '+escapeHtml(next.title) : "You're all caught up"}</div>
          ${next ? `<button class="btn-primary" onclick="location.hash='#/read/${s.id}/${next.id}'">Continue →</button>` : `<button class="btn-ghost" onclick="location.hash='#/series/${s.id}'">Back to Series</button>`}
        </div>
        <div class="chapter-nav">
          <button class="btn-ghost" ${prev?`onclick="location.hash='#/read/${s.id}/${prev.id}'"`:'disabled style="opacity:.3"'}>← Previous</button>
          <button class="btn-ghost" onclick="location.hash='#/series/${s.id}'">All Chapters</button>
          <button class="btn-ghost" ${next?`onclick="location.hash='#/read/${s.id}/${next.id}'"`:'disabled style="opacity:.3"'}>Next →</button>
        </div>

        <div class="comments">
          <h3>Comments (${comments.length})</h3>
          <div class="comment-form">
            <input id="commentName" placeholder="Your name" style="max-width:150px;"/>
            <input id="commentText" placeholder="Say something about this chapter…"/>
            <button class="btn-primary" id="commentSend">Post</button>
          </div>
          <div id="commentList">
            ${comments.slice().reverse().map(c=>`
              <div class="comment">
                <span class="who">${escapeHtml(c.who)}</span><span class="when">${timeAgo(c.ts)}</span>
                <p>${escapeHtml(c.text)}</p>
              </div>
            `).join('') || '<div style="color:var(--muted);font-size:13px;">No comments yet — start the conversation.</div>'}
          </div>
        </div>
      </div>
    </div>
  `;

  const rail = document.getElementById('railFill');
  function onScroll(){
    const h = document.documentElement.scrollHeight - window.innerHeight;
    const pct = h>0 ? Math.min(100, Math.max(0,(window.scrollY/h)*100)) : 0;
    rail.style.height = pct+'%';
  }
  window.addEventListener('scroll', onScroll);
  onScroll();
  window.scrollTo(0,0);

  document.getElementById('commentSend').onclick = async ()=>{
    const who = document.getElementById('commentName').value.trim() || 'Anonymous';
    const text = document.getElementById('commentText').value.trim();
    if(!text) return;
    await Store.addComment(chapterId, who, text);
    document.getElementById('commentText').value='';
    renderReader(seriesId, chapterId);
  };
}

async function renderLibrary(){
  const lib = await Store.getLibrary();
  const series = (await Promise.all(lib.map(id=>Store.getSeries(id)))).filter(Boolean);
  app.innerHTML = `
    <div class="shelf" style="margin-top:32px;">
      <div class="shelf-head"><h2><span class="tick"></span>My Library</h2><span class="count">${series.length} series</span></div>
      ${series.length ? `<div class="grid-series">${series.map(seriesCard).join('')}</div>` :
        `<div class="empty-state"><h3>Your library is empty</h3>Add series you're following from any series page.</div>`}
    </div>
  `;
}

/* ---- upload / create flow ---- */
let uploadState = { panels: [] };

function panelEditorRow(i){
  return `
  <div class="panel-editor" data-idx="${i}">
    <div class="panel-editor-row">
      <input type="text" placeholder="Image URL (optional — leave blank for a generated ink panel)" class="panel-url" />
      <button class="remove-x" onclick="removePanelRow(${i})">✕</button>
    </div>
  </div>`;
}
window.removePanelRow = function(i){
  uploadState.panels.splice(i,1);
  renderPanelEditors();
};
function renderPanelEditors(){
  const wrap = document.getElementById('panelEditors');
  if(!wrap) return;
  wrap.innerHTML = uploadState.panels.map((p,i)=>panelEditorRow(i)).join('');
  wrap.querySelectorAll('.panel-url').forEach((inp,i)=>{
    inp.value = uploadState.panels[i] || '';
    inp.oninput = ()=>{ uploadState.panels[i] = inp.value; };
  });
}

async function renderUpload(){
  uploadState = { panels: ["","",""] };
  const all = await Store.getAllSeries();
  app.innerHTML = `
    <div class="form-card">
      <h2>Publish a New Series</h2>
      <div class="sub">This page isn't linked from the site nav — bookmark it. Publishing as <b style="color:var(--paper)">${escapeHtml(ARTIST.name)}</b>.</div>
      <div class="field"><label>Title</label><input id="fTitle" placeholder="e.g. Nine Tailwinds"/></div>
      <div class="field"><label>Author name</label><input id="fAuthor" placeholder="Your pen name" value="${escapeHtml(ARTIST.name)}"/></div>
      <div class="field"><label>Genre</label>
        <select id="fGenre">${GENRES.map(g=>`<option value="${g}">${g}</option>`).join('')}</select>
      </div>
      <div class="field"><label>Synopsis</label><textarea id="fSyn" placeholder="What's this story about?"></textarea></div>

      <div class="field">
        <label>First chapter — panels</label>
        <div id="panelEditors"></div>
        <button class="add-panel-btn" id="addPanelBtn">+ Add panel</button>
      </div>

      <button class="btn-primary" id="publishBtn" style="width:100%;padding:14px;font-size:14px;">Publish Series</button>
    </div>

    ${all.length ? `
    <div class="shelf">
      <div class="shelf-head"><h2><span class="tick"></span>Add a Chapter to an Existing Series</h2></div>
      <div class="grid-series">
        ${all.map(s=>`<div class="card" onclick="location.hash='#/add-chapter/${s.id}'">
          <div class="cover" style="${coverStyle(s.id)}">
            <div><span class="genre-pill">${s.genre}</span><br/><span class="title">${escapeHtml(s.title)}</span></div>
          </div>
          <div class="meta"><span class="author">${escapeHtml(s.author)}</span>${s.chapters.length} ch</div>
        </div>`).join('')}
      </div>
    </div>` : ''}
  `;
  renderPanelEditors();
  document.getElementById('addPanelBtn').onclick = ()=>{ uploadState.panels.push(""); renderPanelEditors(); };

  document.getElementById('publishBtn').onclick = async ()=>{
    const title = document.getElementById('fTitle').value.trim();
    const author = document.getElementById('fAuthor').value.trim() || 'Anonymous';
    const genre = document.getElementById('fGenre').value;
    const synopsis = document.getElementById('fSyn').value.trim();
    if(!title || !synopsis){ toast('Add a title and synopsis first'); return; }
    const id = uid('s');
    const now = Date.now();
    const panels = uploadState.panels.map((url,i)=>({ url: url? url.trim(): null, seed: id+'-1-'+i, caption:'panel '+(i+1) }));
    const chapter = { id: uid('ch'), num:1, title:'Chapter 1', panels: panels.length?panels:[{url:null,seed:id+'-1-0',caption:'panel 1'}], createdAt: now };
    const series = { id, title, author, genre, synopsis, chapters:[chapter], likes:0, views:0, createdAt:now, updatedAt:now };
    await Store.saveSeries(series);
    const idx = await Store.getIndex();
    idx.push(id);
    await Store.saveIndex(idx);
    toast('Series published!');
    location.hash = '#/series/'+id;
  };
}

async function renderAddChapter(seriesId){
  const s = await Store.getSeries(seriesId);
  if(!s){ app.innerHTML = `<div class="empty-state"><h3>Series not found</h3></div>`; return; }
  uploadState = { panels: ["","",""] };
  app.innerHTML = `
    <div class="form-card">
      <h2>New Chapter</h2>
      <div class="sub">Adding to <b style="color:var(--paper)">${escapeHtml(s.title)}</b> — will be chapter ${s.chapters.length+1}</div>
      <div class="field"><label>Chapter title</label><input id="fCTitle" placeholder="e.g. The Long Way Home" /></div>
      <div class="field">
        <label>Panels</label>
        <div id="panelEditors"></div>
        <button class="add-panel-btn" id="addPanelBtn">+ Add panel</button>
      </div>
      <button class="btn-primary" id="publishChBtn" style="width:100%;padding:14px;font-size:14px;">Publish Chapter</button>
    </div>
  `;
  renderPanelEditors();
  document.getElementById('addPanelBtn').onclick = ()=>{ uploadState.panels.push(""); renderPanelEditors(); };
  document.getElementById('publishChBtn').onclick = async ()=>{
    const title = document.getElementById('fCTitle').value.trim();
    if(!title){ toast('Give the chapter a title'); return; }
    const num = s.chapters.length+1;
    const chId = uid('ch');
    const panels = uploadState.panels.map((url,i)=>({ url: url? url.trim(): null, seed: chId+'-'+i, caption:'panel '+(i+1) }));
    s.chapters.push({ id:chId, num, title, panels: panels.length?panels:[{url:null,seed:chId+'-0',caption:'panel 1'}], createdAt:Date.now() });
    s.updatedAt = Date.now();
    await Store.saveSeries(s);
    toast('Chapter published!');
    location.hash = '#/series/'+s.id;
  };
}

async function renderSearch(q){
  const all = await Store.getAllSeries();
  const qq = q.toLowerCase();
  const results = all.filter(s => s.title.toLowerCase().includes(qq) || s.author.toLowerCase().includes(qq));
  app.innerHTML = `
    <div class="shelf" style="margin-top:32px;">
      <div class="shelf-head"><h2><span class="tick"></span>Results for "${escapeHtml(q)}"</h2><span class="count">${results.length} found</span></div>
      ${results.length ? `<div class="grid-series">${results.map(seriesCard).join('')}</div>` :
        `<div class="empty-state"><h3>Nothing matched</h3>Try a different title or author.</div>`}
    </div>
  `;
}

/* ================= ROUTER ================= */
function setActiveNav(route){
  document.querySelectorAll('#siteNav a').forEach(a=>{
    a.classList.toggle('active', a.dataset.route===route);
  });
}

async function router(){
  const hash = location.hash || '#/home';
  const parts = hash.replace('#/','').split('/').filter(Boolean);
  window.scrollTo(0,0);

  if(parts[0]==='home' || parts.length===0){ setActiveNav('home'); await renderHome(); }
  else if(parts[0]==='browse'){ setActiveNav('browse'); await renderBrowse(parts[1] ? decodeURIComponent(parts[1]) : null); }
  else if(parts[0]==='series' && parts[1]){ setActiveNav(''); await renderSeries(parts[1]); }
  else if(parts[0]==='read' && parts[1] && parts[2]){ setActiveNav(''); await renderReader(parts[1], parts[2]); }
  else if(parts[0]==='upload'){ setActiveNav(''); await renderUpload(); }
  else if(parts[0]==='add-chapter' && parts[1]){ setActiveNav(''); await renderAddChapter(parts[1]); }
  else if(parts[0]==='about'){ setActiveNav('about'); await renderAbout(); }
  else if(parts[0]==='library'){ setActiveNav('library'); await renderLibrary(); }
  else if(parts[0]==='search' && parts[1]){ setActiveNav(''); await renderSearch(decodeURIComponent(parts[1])); }
  else { setActiveNav('home'); await renderHome(); }
}

window.addEventListener('hashchange', router);
window.addEventListener('DOMContentLoaded', router);
router();
document.getElementById('footerArtist').textContent = ARTIST.name;

document.getElementById('searchInput').addEventListener('keydown', (e)=>{
  if(e.key==='Enter'){
    const v = e.target.value.trim();
    if(v) location.hash = '#/search/'+encodeURIComponent(v);
  }
});
</script>
